{
	"name": "complianty/complianty-connector",
	"description": "Shows the status of your Complianty website scan in the WordPress admin and outputs your privacy policy.",
	"version": "1.0.0",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"brain/monkey": "^2.6",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^1.11",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^1.3",
		"wp-coding-standards/wpcs": "^3.0",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"autoload": {
		"psr-4": {
			"Complianty\\Connector\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Complianty\\Connector\\Tests\\": "tests/"
		}
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "7.4.33"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"fix": "phpcbf",
		"stan": "phpstan analyse --memory-limit=1G",
		"test": "phpunit",
		"check": [
			"@lint",
			"@stan",
			"@test"
		],
		"build": "composer install --no-dev --classmap-authoritative --no-interaction"
	}
}
