#. Plugin Name of the plugin
#: src/Admin/SettingsPage.php:166
#: src/Admin/SettingsPage.php:314
#: src/Support/Privacy.php:36
msgid "Complianty Connector"
msgstr "Complianty Connector"

#. Plugin URI of the plugin
#. Author URI of the plugin
msgid "https://complianty.de/"
msgstr ""

#. Description of the plugin
msgid "Shows the status of your Complianty website scan in the WordPress admin and outputs your privacy policy from your Complianty account."
msgstr "Zeigt den Status Ihres Complianty-Website-Scans im WordPress-Admin und gibt Ihre Datenschutzerklärung aus Ihrem Complianty-Konto aus."

#. Author of the plugin
#: src/Admin/SettingsPage.php:167
msgid "Complianty"
msgstr ""

#: complianty-connector.php:34
msgid "Complianty Connector: The installation is incomplete. Please reinstall the plugin."
msgstr "Complianty Connector: Die Installation ist unvollständig. Bitte installieren Sie das Plugin neu."

#: src/Admin/DashboardWidget.php:73
msgid "Complianty status"
msgstr "Complianty-Status"

#: src/Admin/DashboardWidget.php:115
msgid "Details and scan"
msgstr "Details und Scan"

#: src/Admin/DashboardWidget.php:117
msgid "Complianty dashboard"
msgstr "Complianty-Dashboard"

#: src/Admin/Notices.php:97
msgid "The connection was removed. The token and the cached data were deleted from this site."
msgstr "Die Verbindung wurde entfernt. Das Token und die zwischengespeicherten Daten wurden von dieser Website gelöscht."

#: src/Admin/Notices.php:99
msgid "The status was updated."
msgstr "Der Status wurde aktualisiert."

#: src/Admin/Notices.php:101
msgid "The privacy policy was checked."
msgstr "Die Datenschutzerklärung wurde geprüft."

#: src/Admin/Notices.php:103
msgid "The token was saved."
msgstr "Das Token wurde gespeichert."

#: src/Admin/SettingsPage.php:152
msgid "Settings"
msgstr "Einstellungen"

#: src/Admin/SettingsPage.php:239
msgid "The token was saved. The first status check runs when you open this page."
msgstr "Das Token wurde gespeichert. Die erste Statusabfrage erfolgt beim Öffnen dieser Seite."

#: src/Admin/SettingsPage.php:250
msgid "This is not a valid connection token. Copy the token from your Complianty account without spaces."
msgstr "Das ist kein gültiges Verbindungstoken. Kopieren Sie das Token aus Ihrem Complianty-Konto ohne Leerzeichen."

#: src/Admin/SettingsPage.php:262
msgid "The token is set in wp-config.php. Remove COMPLIANTY_API_TOKEN there to change it here."
msgstr "Das Token ist in der wp-config.php gesetzt. Entfernen Sie dort COMPLIANTY_API_TOKEN, um es hier zu ändern."

#: src/Admin/SettingsPage.php:265
msgid "The token could not be stored securely because PHP libsodium is not available. Set COMPLIANTY_API_TOKEN in wp-config.php instead."
msgstr "Das Token konnte nicht sicher gespeichert werden, weil PHP libsodium nicht verfügbar ist. Setzen Sie stattdessen COMPLIANTY_API_TOKEN in der wp-config.php."

#: src/Admin/SettingsPage.php:310
msgid "You are not allowed to access this page."
msgstr "Sie dürfen diese Seite nicht aufrufen."

#: src/Admin/SettingsPage.php:318
msgid "JavaScript is needed for scan progress. The other functions work without it."
msgstr "Für den Scan-Fortschritt wird JavaScript benötigt. Die anderen Funktionen laufen auch ohne."

#: src/Admin/SettingsPage.php:348
#: src/Admin/SettingsPage.php:355
msgid "Connect"
msgstr "Verbinden"

#: src/Admin/SettingsPage.php:349
msgid "Create a connection token for this website in your Complianty account and paste it here. Until you do, this plugin does not contact any external service."
msgstr "Erstellen Sie in Ihrem Complianty-Konto ein Verbindungstoken für diese Website und fügen Sie es hier ein. Bis dahin nimmt dieses Plugin keinen Kontakt zu externen Diensten auf."

#: src/Admin/SettingsPage.php:353
msgid "Connection token"
msgstr "Verbindungstoken"

#: src/Admin/SettingsPage.php:358
msgid "Alternative: define the token in wp-config.php. Then nothing is stored in the database."
msgstr "Alternative: Definieren Sie das Token in der wp-config.php. Dann wird nichts in der Datenbank gespeichert."

#: src/Admin/SettingsPage.php:362
msgid "You do not have an account yet?"
msgstr "Sie haben noch kein Konto?"

#: src/Admin/SettingsPage.php:364
msgid "Create one at Complianty"
msgstr "Bei Complianty erstellen"

#: src/Admin/SettingsPage.php:380
msgid "Connection"
msgstr "Verbindung"

#: src/Admin/SettingsPage.php:383
msgid "The token cannot be read. It is either invalid or, if it is stored in the database, the WordPress security keys changed. Disconnect and connect again with a new token."
msgstr "Das Token kann nicht gelesen werden. Es ist entweder ungültig oder, falls es in der Datenbank liegt, haben sich die WordPress-Sicherheitsschlüssel geändert. Trennen Sie die Verbindung und verbinden Sie sich erneut mit einem neuen Token."

#: src/Admin/SettingsPage.php:387
msgid "Token:"
msgstr "Token:"

#: src/Admin/SettingsPage.php:392
msgid "State:"
msgstr "Status:"

#: src/Admin/SettingsPage.php:398
msgid "The token is provided by wp-config.php. To disconnect, remove COMPLIANTY_API_TOKEN there."
msgstr "Das Token kommt aus der wp-config.php. Zum Trennen entfernen Sie dort COMPLIANTY_API_TOKEN."

#: src/Admin/SettingsPage.php:403
msgid "Disconnect"
msgstr "Trennen"

#: src/Admin/SettingsPage.php:405
msgid "Disconnecting deletes the token, the cached status and the stored privacy policy copy from this site."
msgstr "Beim Trennen werden das Token, der zwischengespeicherte Status und die gespeicherte Kopie der Datenschutzerklärung von dieser Website gelöscht."

#: src/Admin/SettingsPage.php:421
#: src/Admin/SettingsPage.php:503
msgid "Privacy policy"
msgstr "Datenschutzerklärung"

#: src/Admin/SettingsPage.php:424
msgid "A new version is waiting for approval in Complianty. Until then the last approved version stays on your website."
msgstr "Eine neue Fassung wartet in Complianty auf Freigabe. Bis dahin bleibt die zuletzt freigegebene Fassung auf Ihrer Website."

#: src/Admin/SettingsPage.php:426
msgid "No privacy policy was found in your Complianty account."
msgstr "In Ihrem Complianty-Konto wurde keine Datenschutzerklärung gefunden."

#: src/Admin/SettingsPage.php:428
msgid "The Complianty subscription has ended. The service now provides a notice instead of the policy, and your website shows that notice."
msgstr "Das Complianty-Abonnement ist beendet. Der Dienst liefert jetzt einen Hinweis statt der Datenschutzerklärung, und Ihre Website zeigt diesen Hinweis."

#: src/Admin/SettingsPage.php:433
msgid "The stored copy is the notice of the service."
msgstr "Die gespeicherte Kopie ist der Hinweis des Dienstes."

#. translators: %s: approval date
#: src/Admin/SettingsPage.php:440
msgid "Approved version from: %s"
msgstr "Freigegebene Fassung vom: %s"

#. translators: %s: date and time of the last check
#: src/Admin/SettingsPage.php:451
msgid "Last checked: %s"
msgstr "Zuletzt geprüft: %s"

#: src/Admin/SettingsPage.php:457
msgid "There is no approved privacy policy on this site yet."
msgstr "Auf dieser Website gibt es noch keine freigegebene Datenschutzerklärung."

#: src/Admin/SettingsPage.php:460
msgid "Output the privacy policy from your Complianty account with the shortcode or the block \"Privacy policy (Complianty)\"."
msgstr "Geben Sie die Datenschutzerklärung aus Ihrem Complianty-Konto mit dem Shortcode oder dem Block \"Datenschutzerklärung (Complianty)\" aus."

#: src/Admin/SettingsPage.php:470
msgid "Show a link to Complianty below the privacy policy"
msgstr "Link zu Complianty unter der Datenschutzerklärung anzeigen"

#: src/Admin/SettingsPage.php:472
msgid "Off by default. If you turn it on, a short link to complianty.de appears below the privacy policy on your website."
msgstr "Standardmäßig aus. Wenn Sie ihn einschalten, erscheint unter der Datenschutzerklärung auf Ihrer Website ein kurzer Link zu complianty.de."

#: src/Admin/SettingsPage.php:473
msgid "Save"
msgstr "Speichern"

#: src/Admin/SettingsPage.php:479
msgid "Update privacy policy"
msgstr "Datenschutzerklärung aktualisieren"

#: src/Admin/SettingsPage.php:491
msgid "External services"
msgstr "Externe Dienste"

#: src/Admin/SettingsPage.php:492
msgid "This plugin connects your server to the Complianty service at app.complianty.de."
msgstr "Dieses Plugin verbindet Ihren Server mit dem Dienst Complianty unter app.complianty.de."

#: src/Admin/SettingsPage.php:494
msgid "Before you enter a token, nothing is sent. The only exception is the optional free check, which runs only after you press its button and sends the address of this website."
msgstr "Bevor Sie ein Token eingeben, wird nichts gesendet. Einzige Ausnahme ist der optionale kostenlose Check, der erst nach Klick auf seinen Button läuft und die Adresse dieser Website sendet."

#: src/Admin/SettingsPage.php:495
msgid "With a token, your server sends the token and the plugin version. No website address, user name or WordPress version is sent."
msgstr "Mit Token sendet Ihr Server das Token und die Plugin-Version. Es werden keine Website-Adresse, kein Benutzername und keine WordPress-Version gesendet."

#: src/Admin/SettingsPage.php:496
msgid "Requests happen when you open this page or the dashboard, press Refresh or Scan now, and in the background to keep the privacy policy copy current."
msgstr "Anfragen erfolgen, wenn Sie diese Seite oder das Dashboard öffnen, auf Aktualisieren oder Jetzt scannen klicken, und im Hintergrund, um die Kopie der Datenschutzerklärung aktuell zu halten."

#: src/Admin/SettingsPage.php:497
msgid "Visitors of your website never contact Complianty. Your server fetches the data."
msgstr "Besucher Ihrer Website nehmen nie Kontakt zu Complianty auf. Ihr Server holt die Daten ab."

#: src/Admin/SettingsPage.php:498
msgid "The token is stored encrypted with libsodium, using a key derived from your WordPress security keys. This protects against leaks of the database alone, not against access to wp-config.php."
msgstr "Das Token wird mit libsodium verschlüsselt gespeichert, mit einem aus Ihren WordPress-Sicherheitsschlüsseln abgeleiteten Schlüssel. Das schützt bei einem Datenbank-Leck allein, nicht bei Zugriff auf die wp-config.php."

#: src/Admin/SettingsPage.php:505
msgid "Terms of service"
msgstr "Allgemeine Geschäftsbedingungen"

#: src/Admin/SettingsPage.php:572
msgid "You are not allowed to do this."
msgstr "Sie dürfen das nicht ausführen."

#: src/Admin/SettingsPage.php:577
msgid "Invalid request."
msgstr "Ungültige Anfrage."

#: src/Admin/SettingsPage.php:611
msgid "unknown"
msgstr "unbekannt"

